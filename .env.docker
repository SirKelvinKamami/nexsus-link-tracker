# Application
APP_NAME="Nexsus Link Tracker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# Server
APP_PORT=8080

# Database (SQLite by default)
DB_CONNECTION=sqlite

# Cache/Session
