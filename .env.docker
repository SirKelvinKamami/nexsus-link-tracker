SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# API Token (for third-party access)
API_TOKEN=

# Google Analytics
GA4_ID=
GTM_ID=

# DAS Hub Integration
VITE_TRACKER_URL=http://localhost:8080
VITE_TRACKER_TOKEN=
