# ==========================================
# NEXSUS LINK TRACKER — PRODUCTION ENV TEMPLATE
# ==========================================
# Copy to .env and fill in ALL "CHANGE_ME" values
# ==========================================

# --- App ---
APP_NAME="Nexsus"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_KEY=base64:CHANGE_ME_RUN_PHP_ARTISAN_KEY_GENERATE

# --- Database (Render PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_RENDER_PG_HOST
DB_PORT=5432
DB_DATABASE=nexsus
DB_USERNAME=nexsus_user
DB_PASSWORD=CHANGE_ME_RENDER_PG_PASSWORD

# --- Mail (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Cache / Session / Queue (Database-backed for simplicity) ---
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
SESSION_LIFETIME=120

# --- Redis (Optional - for Horizon/Reverb) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Security ---
FORCE_HTTPS=true
FORCE_ROUTE_HTTPS=true

# --- Registration ---
ALLOW_REGISTRATION=true
MANUAL_USER_VERIFICATION=false
REGISTER_AUTH=auth

# --- Analytics (Optional) ---
GTM_ID=
GA4_ID=

# --- API ---
API_TOKEN=CHANGE_ME_GENERATE_RANDOM_64_CHAR_STRING

# --- Logging ---
LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Maintenance ---
MAINTENANCE_MODE=false

# --- Optional Features ---
ENABLE_BUTTON_EDITOR=true
ENABLE_SOCIAL_LOGIN=false
ALLOW_USER_HTML=true
ALLOW_CUSTOM_BACKGROUNDS=true
ALLOW_USER_EXPORT=true
ALLOW_USER_IMPORT=true
ENABLE_REPORT_ICON=false
ENABLE_ADMIN_BAR=true
ENABLE_ADMIN_BAR_USERS=false
HIDE_VERIFICATION_CHECKMARK=false

# --- Footer ---
DISPLAY_FOOTER=true
DISPLAY_CREDIT=true
DISPLAY_CREDIT_FOOTER=true
DISPLAY_FOOTER_HOME=true
DISPLAY_FOOTER_TERMS=true
DISPLAY_FOOTER_PRIVACY=true
DISPLAY_FOOTER_CONTACT=true

# --- Updater ---
JOIN_BETA=false
SKIP_UPDATE_BACKUP=false
ENABLE_THEME_UPDATER=true
ALLOW_CUSTOM_CODE_IN_THEMES=true
USE_THEME_PREVIEW_IFRAME=true